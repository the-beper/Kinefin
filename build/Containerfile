FROM registry.fedoraproject.org/fedora:45

# The build/check image (localhost/kinefin-build:fedora45 locally, ghcr.io/the-beper/kinefin-build:fedora45 in CI, images.yml). Everything build/check.sh needs. Package notes for Fedora 45, verified on this machine (dnf):
#   - libmpv headers are `mpv-devel` (0.41.0); the old name `mpv-libs-devel` does not exist here.
#   - Gamepad input is SDL3 (`SDL3-devel`, 3.4.x); SDL2 in Fedora is a compat shim over SDL3.
#   - `clang-tools-extra` provides the clang-format used by the .clang-format style gate in check.sh.
#   - `qtkeychain-qt6-devel` (0.17.0) is the token store's library; the image has no secret service, so the store fails closed in tests.
#   - `ccache` is picked up by check.sh when present (CI keeps its cache between runs).
#   - `diffutils` (`cmp`, `diff`) is used by the release scripts and their simulation; the base image does not have it.
# - There is no mpvqt package: dev builds compile the pinned mpvqt tarball as a CMake subproject (VERSION pins in the root CMakeLists.txt), release builds the same from the Flathub manifest.
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config git ccache diffutils \
        clang-tools-extra cppcheck reuse \
        dbus-devel dbus-daemon libxml2 desktop-file-utils appstream gettext curl \
        mpv-devel SDL3-devel \
        qt6-qtbase-devel qt6-qtbase-private-devel qt6-qtdeclarative-devel qt6-qtsvg-devel qt6-qtwayland-devel \
        qt6-qtwebsockets-devel openssl-devel \
        extra-cmake-modules \
        kf6-kirigami-devel kf6-kirigami-addons kf6-ki18n-devel kf6-kconfig-devel \
        kf6-kcoreaddons-devel kf6-kcrash-devel kf6-kdbusaddons-devel kf6-kwindowsystem-devel \
        qtkeychain-qt6-devel kf6-qqc2-desktop-style \
    && dnf clean all

# Links the ghcr.io package to the repository, so the workflows can pull it with GITHUB_TOKEN.
LABEL org.opencontainers.image.source="https://github.com/the-beper/Kinefin"
