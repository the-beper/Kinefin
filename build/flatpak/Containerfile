FROM registry.fedoraproject.org/fedora:45

# The image build/flatpak/build-flatpak.sh and test-flatpak.sh run flatpak and ostree in. It carries nothing else (flatpak-builder included) on purpose: quickcheck of tools happens in the scripts (they refuse a rootful podman).
RUN dnf install -y --setopt=install_weak_deps=False \
        flatpak flatpak-builder ostree squashfs-tools curl git dbus-daemon \
    && dnf clean all

# Links the ghcr.io package to the repository, so the workflows can pull it with GITHUB_TOKEN.
LABEL org.opencontainers.image.source="https://github.com/the-beper/Kinefin"
