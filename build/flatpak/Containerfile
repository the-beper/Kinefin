FROM registry.fedoraproject.org/fedora:45

# The Flatpak builder and smoke test run here. Python 3 validates the installed
# bundle metadata against the reviewed sandbox policy before launching Kinefin.
# The scripts still require rootless podman on the host.
RUN dnf install -y --setopt=install_weak_deps=False \
        flatpak flatpak-builder ostree squashfs-tools curl git dbus-daemon python3 \
    && dnf clean all

# Links the ghcr.io package to the repository, so the workflows can pull it with GITHUB_TOKEN.
LABEL org.opencontainers.image.source="https://github.com/the-beper/Kinefin"
