"""A stand-in for the gh CLI, for build/release/simulate.sh: it answers the one call the release scripts make, `gh api --paginate repos/OWNER/REPO/releases`, with the releases of a JSON file.

Environment:
  FAKE_GH_STATE    JSON file with {"releases": [...]} (each release has tag_name, draft, prerelease and assets)
"""
import json
import os
import sys
from typing import NoReturn

STATE = os.environ["FAKE_GH_STATE"]


def die(message: str, code: int = 1) -> NoReturn:
    print("fake-gh: " + message, file=sys.stderr)
    sys.exit(code)


def main() -> None:
    args = sys.argv[1:]
    if not os.environ.get("GH_TOKEN"):
        die("gh: GH_TOKEN is not set", 4)
    if len(args) < 2 or args[0] != "api":
        die("unsupported command: " + " ".join(args), 99)
    endpoint = [a for a in args[1:] if not a.startswith("-")][0].split("?")[0]
    parts = endpoint.split("/")
    if len(parts) != 4 or parts[0] != "repos" or parts[3] != "releases":
        die("unsupported api call: " + endpoint, 99)
    with open(STATE) as f:
        print(json.dumps(json.load(f)["releases"]))


main()
