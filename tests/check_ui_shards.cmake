# Fails when the ui_pages shards miss a test function of test_ui_pages (the shard lists are read from the source at configure time)
execute_process(COMMAND "${BIN}" -functions OUTPUT_VARIABLE listed RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "${BIN} -functions failed")
endif()
string(REGEX REPLACE "\\(\\)" "" listed "${listed}")
string(REGEX REPLACE "[\r\n]+" ";" listed "${listed}")
list(FILTER listed EXCLUDE REGEX "^$")
list(SORT listed)
list(SORT SHARDED)
if(NOT listed STREQUAL SHARDED)
    set(missing ${listed})
    list(REMOVE_ITEM missing ${SHARDED})
    set(extra ${SHARDED})
    list(REMOVE_ITEM extra ${listed})
    message(FATAL_ERROR "ui_pages shards out of step with the test class. Not in a shard: [${missing}]. In a shard but not a test: [${extra}]")
endif()
