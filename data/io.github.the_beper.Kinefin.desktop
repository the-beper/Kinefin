[Desktop Entry]
Type=Application
Name=Kinefin
GenericName=Jellyfin Client
GenericName[it]=Client Jellyfin
GenericName[nl]=Jellyfin-cliënt
GenericName[tr]=Jellyfin İstemcisi
Comment=Browse movies and TV series from your Jellyfin server
Comment[it]=Esplora film e serie TV dal tuo server Jellyfin
Exec=kinefin %u
Icon=io.github.the_beper.Kinefin
Terminal=false
Categories=AudioVideo;Video;Qt;
MimeType=x-scheme-handler/jellyfin;
Keywords=jellyfin;media;video;movies;tv;
SingleMainWindow=true
StartupNotify=true
X-KDE-StartupNotify=true
